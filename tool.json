{
  "tool": {
    "id": "gleason-isup",
    "title": "Gleason e grupo de grau ISUP",
    "short": "Converte o escore de Gleason no grupo de grau (1 a 5)",
    "desc": "Converte os padrões de Gleason (primário + secundário) no grupo de grau ISUP 2014/OMS do câncer de próstata, com o prognóstico após prostatectomia.",
    "lead": "Transforma o escore de Gleason do adenocarcinoma de próstata no grupo de grau ISUP (1 a 5), que separa melhor o prognóstico, sobretudo entre 3 + 4 e 4 + 3.",
    "kind": "Calculadora",
    "spec": [
      "patologia",
      "urologia",
      "oncologia-clinica",
      "radioterapia"
    ],
    "fields": [
      [
        "p",
        "Padrão primário (mais extenso)",
        "radio",
        {
          "opts": {
            "3": "3",
            "4": "4",
            "5": "5"
          }
        }
      ],
      [
        "s",
        "Padrão secundário",
        "radio",
        {
          "opts": {
            "3": "3",
            "4": "4",
            "5": "5"
          }
        }
      ]
    ],
    "formula": "<p>Gleason ≤ 6 = <strong>grupo 1</strong> · 3 + 4 = 7 = <strong>grupo 2</strong> · 4 + 3 = 7 = <strong>grupo 3</strong> · 8 (4 + 4, 3 + 5, 5 + 3) = <strong>grupo 4</strong> · 9 a 10 = <strong>grupo 5</strong>.</p>",
    "sources": [
      [
        "Epstein JI et al. The 2014 International Society of Urological Pathology (ISUP) consensus conference on Gleason grading of prostatic carcinoma. Am J Surg Pathol, 2016.",
        "https://doi.org/10.1097/PAS.0000000000000530"
      ],
      [
        "Epstein JI et al. A contemporary prostate cancer grading system: a validated alternative to the Gleason score. Eur Urol, 2016.",
        "https://doi.org/10.1016/j.eururo.2015.06.046"
      ]
    ],
    "cases": [
      [
        "3 + 3 = 6: grupo 1",
        {
          "p": "3",
          "s": "3"
        },
        {
          "raw": {
            "gg": 1,
            "sum": 6
          },
          "main": "Grupo 1",
          "level": "low"
        }
      ],
      [
        "3 + 4 = 7: grupo 2",
        {
          "p": "3",
          "s": "4"
        },
        {
          "raw": {
            "gg": 2
          },
          "level": "mid"
        }
      ],
      [
        "4 + 3 = 7: grupo 3",
        {
          "p": "4",
          "s": "3"
        },
        {
          "raw": {
            "gg": 3
          },
          "level": "mid"
        }
      ],
      [
        "3 + 5 = 8: grupo 4",
        {
          "p": "3",
          "s": "5"
        },
        {
          "raw": {
            "gg": 4
          },
          "level": "high"
        }
      ],
      [
        "5 + 4 = 9: grupo 5",
        {
          "p": "5",
          "s": "4"
        },
        {
          "raw": {
            "gg": 5,
            "sum": 9
          },
          "level": "high"
        }
      ]
    ],
